@page
@using TmkChamados.Models
@model ChamadoViewModel
@{
    ViewData["Title"] = "Visualizar Chamado";
}

@if (Model.Chamado is null)
{
    <p>Chamado não encontrado.</p>
}
else
{
    var chamado = Model.Chamado;

    <div class="tmk-eyebrow">Chamado #@chamado.Id</div>
    <h1>@chamado.Titulo</h1>
    <p class="mb-3">
        <span class="tmk-chip">@chamado.Status</span>
        <span class="tmk-chip">@chamado.Prioridade</span>
    </p>

    <form method="post" asp-page-handler="Atualizar" class="tmk-card mb-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-2">
            <label class="form-label">Id</label>
            <input type="text" value="@chamado.Id" class="form-control" readonly />
        </div>

        <div class="mb-2">
            <label asp-for="Form.Titulo" class="form-label">Título</label>
            <input asp-for="Form.Titulo" class="form-control" />
            <span asp-validation-for="Form.Titulo" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Form.Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Form.Descricao" class="form-control"></textarea>
        </div>

        <div class="mb-2">
            <label asp-for="Form.Status" class="form-label">Status</label>
            <select asp-for="Form.Status" class="form-select"
                    asp-items="Html.GetEnumSelectList<StatusChamado>()"></select>
        </div>

        <div class="mb-2">
            <label asp-for="Form.Prioridade" class="form-label">Prioridade</label>
            <select asp-for="Form.Prioridade" class="form-select">
                <option value="">Selecione</option>
                <option value="Normal">Normal</option>
                <option value="Alta">Alta</option>
                <option value="Urgente">Urgente</option>
            </select>
            <span asp-validation-for="Form.Prioridade" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Form.DataPrazo" class="form-label">Data de Prazo</label>
            <input asp-for="Form.DataPrazo" type="date" class="form-control" />
            <span asp-validation-for="Form.DataPrazo" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Form.ResponsavelId" class="form-label">Responsável</label>
            <select asp-for="Form.ResponsavelId" class="form-select">
                <option value="">Nenhum</option>
                @foreach (var usuario in Model.UsuariosMaster)
                {
                    <option value="@usuario.Id">@usuario.Nome</option>
                }
            </select>
            <span asp-validation-for="Form.ResponsavelId" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label class="form-label">Criado por</label>
            <input type="text" value="@(Model.NomesPorId.TryGetValue(chamado.CriadoPorId, out var criadoPorNome) ? criadoPorNome : "-")" class="form-control" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label">Criado em</label>
            <input type="text" value="@chamado.DataCriacao.ToString("dd/MM/yyyy HH:mm")" class="form-control" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label">Última modificação</label>
            <input type="text" value="@chamado.DataUltimaModificacao.ToString("dd/MM/yyyy HH:mm")" class="form-control" readonly />
        </div>

        <div class="mb-2">
            <label class="form-label">Conclusão</label>
            <input type="text" value="@(chamado.DataConclusao.HasValue ? chamado.DataConclusao.Value.ToString("dd/MM/yyyy HH:mm") : "-")" class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/Chamados" class="btn btn-secondary">Voltar à listagem</a>
    </form>

    <div class="tmk-eyebrow">Andamentos</div>

    @if (!Model.Andamentos.Any())
    {
        <p>Nenhum andamento registrado.</p>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var andamento in Model.Andamentos)
            {
                <li class="list-group-item tmk-card mb-2">
                    <div class="d-flex justify-content-between">
                        <strong>@(Model.NomesPorId.TryGetValue(andamento.CriadoPorId, out var autorNome) ? autorNome : "-")</strong>
                        <span class="small">@andamento.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div>@andamento.Texto</div>
                </li>
            }
        </ul>
    }

    <div class="tmk-eyebrow">Adicionar Andamento</div>

    <form method="post" asp-page-handler="AdicionarAndamento" class="tmk-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="NovoAndamentoTexto" class="form-label">Texto</label>
            <textarea asp-for="NovoAndamentoTexto" class="form-control" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Adicionar</button>
    </form>
}
