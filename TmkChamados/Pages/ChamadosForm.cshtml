@page
@using TmkChamados.Models
@model ChamadosFormModel
@{
    ViewData["Title"] = "Novo Chamado";
}

<div class="tmk-eyebrow">Chamados</div>
<h1>Novo Chamado</h1>

<form method="post" asp-page-handler="Adicionar" class="tmk-card mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Form.Titulo" class="form-label">Título</label>
        <input asp-for="Form.Titulo" class="form-control" />
        <span asp-validation-for="Form.Titulo" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Form.Descricao" class="form-control"></textarea>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Prioridade" class="form-label">Prioridade</label>
        <select asp-for="Form.Prioridade" class="form-select">
            <option value="">Selecione</option>
            <option value="Normal">Normal</option>
            <option value="Alta">Alta</option>
            <option value="Urgente">Urgente</option>
        </select>
        <span asp-validation-for="Form.Prioridade" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.DataPrazo" class="form-label">Data de Prazo</label>
        <input asp-for="Form.DataPrazo" type="date" class="form-control" />
        <span asp-validation-for="Form.DataPrazo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Adicionar</button>
    <a href="/Chamados" class="btn btn-secondary">Cancelar</a>
</form>
