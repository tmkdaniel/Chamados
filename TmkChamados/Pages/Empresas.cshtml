@page
@model EmpresasModel
@{
    ViewData["Title"] = "Empresas";
}

<div class="tmk-eyebrow">Administração</div>
<h1>Empresas</h1>

@if (!string.IsNullOrEmpty(Model.ErroExclusao))
{
    <div class="alert alert-danger">@Model.ErroExclusao</div>
}

<p>
    <a href="/EmpresasForm" class="btn btn-primary">Nova Empresa</a>
</p>

<div class="tmk-eyebrow">Lista de Empresas</div>

@if (!Model.Empresas.Any())
{
    <p>Nenhuma empresa cadastrada.</p>
}
else
{
    <div class="tmk-card p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var empresa in Model.Empresas)
            {
                <tr>
                    <td>@empresa.Id</td>
                    <td>@empresa.Nome</td>
                    <td>
                        <a href="/EmpresasForm?editId=@empresa.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Excluir" asp-route-id="@empresa.Id" id="excluir-empresa-@empresa.Id" class="d-inline"></form>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#modalConfirmarExclusao"
                                onclick="document.getElementById('btnConfirmarExclusao').setAttribute('form', 'excluir-empresa-@empresa.Id')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir esta empresa?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" id="btnConfirmarExclusao" class="btn btn-danger" data-bs-dismiss="modal">Confirmar exclusão</button>
            </div>
        </div>
    </div>
</div>
