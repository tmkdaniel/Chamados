@page
@model EmpresasFormModel
@{
    ViewData["Title"] = Model.EmEdicao ? "Editar Empresa" : "Nova Empresa";
}

<div class="tmk-eyebrow">Administração</div>
<h1>@(Model.EmEdicao ? "Editar Empresa" : "Nova Empresa")</h1>

<form method="post" asp-page-handler="@(Model.EmEdicao ? "Atualizar" : "Adicionar")" class="tmk-card mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Form.Id" />

    @if (Model.EmEdicao)
    {
        <div class="mb-2">
            <label class="form-label">Id</label>
            <input type="text" value="@Model.Form.Id" class="form-control" readonly />
        </div>
    }

    <div class="mb-2">
        <label asp-for="Form.Nome" class="form-label">Nome</label>
        <input asp-for="Form.Nome" class="form-control" />
        <span asp-validation-for="Form.Nome" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        @(Model.EmEdicao ? "Atualizar" : "Adicionar")
    </button>
    <a href="/Empresas" class="btn btn-secondary">Cancelar</a>
</form>
