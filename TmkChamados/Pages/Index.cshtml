@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var opcoesJson = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<h1>Resumo dos Chamados</h1>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <h2>Como Responsável</h2>
        @await Html.PartialAsync("_ResumoChamadosSecao", Model.ResumoResponsavel, new ViewDataDictionary(ViewData) { { "Prefixo", "responsavel" } })
    </div>
    <div class="col-12 col-lg-6">
        <h2>Como Criador</h2>
        @await Html.PartialAsync("_ResumoChamadosSecao", Model.ResumoCriador, new ViewDataDictionary(ViewData) { { "Prefixo", "criador" } })
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        function montarGraficosResumo(prefixo, dados) {
            new Chart(document.getElementById('pizza-' + prefixo), {
                type: 'pie',
                data: {
                    labels: ['Aberto', 'Em Andamento', 'Concluído'],
                    datasets: [{
                        data: [dados.pizzaAbertos, dados.pizzaEmAndamento, dados.pizzaConcluidos],
                        backgroundColor: ['#0d6efd', '#ffc107', '#198754']
                    }]
                },
                options: {
                    maintainAspectRatio: false
                }
            });

            new Chart(document.getElementById('histograma-' + prefixo), {
                type: 'bar',
                data: {
                    labels: dados.histogramaRotulos,
                    datasets: [{
                        label: 'Chamados criados',
                        data: dados.histogramaValores,
                        backgroundColor: '#0d6efd'
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        montarGraficosResumo('responsavel', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResumoResponsavel, opcoesJson)));
        montarGraficosResumo('criador', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResumoCriador, opcoesJson)));
    </script>
}
