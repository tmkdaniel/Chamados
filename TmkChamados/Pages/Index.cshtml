@page
@using TmkChamados.Models
@model IndexModel
@{
    ViewData["Title"] = "Chamados";
}

<h1>Chamados</h1>

<form method="post" asp-page-handler="@(Model.EmEdicao ? "Atualizar" : "Adicionar")" class="mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Form.Id" />

    <div class="mb-2">
        <label asp-for="Form.Titulo" class="form-label">Título</label>
        <input asp-for="Form.Titulo" class="form-control" />
        <span asp-validation-for="Form.Titulo" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Form.Descricao" class="form-control"></textarea>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Status" class="form-label">Status</label>
        <select asp-for="Form.Status" class="form-select"
                asp-items="Html.GetEnumSelectList<StatusChamado>()"></select>
    </div>

    <div class="mb-2">
        <label asp-for="Form.CriadoPorId" class="form-label">Criado por</label>
        <select asp-for="Form.CriadoPorId" class="form-select">
            <option value="">-- Selecione --</option>
            @foreach (var usuario in Model.Usuarios)
            {
                <option value="@usuario.Id">@usuario.Nome</option>
            }
        </select>
        <span asp-validation-for="Form.CriadoPorId" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.ResponsavelId" class="form-label">Responsável</label>
        <select asp-for="Form.ResponsavelId" class="form-select">
            <option value="">-- Selecione --</option>
            @foreach (var usuario in Model.Usuarios)
            {
                <option value="@usuario.Id">@usuario.Nome</option>
            }
        </select>
        <span asp-validation-for="Form.ResponsavelId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        @(Model.EmEdicao ? "Atualizar" : "Adicionar")
    </button>
    @if (Model.EmEdicao)
    {
        <a href="/Index" class="btn btn-secondary">Cancelar</a>
    }
</form>

<h2>Filtrar Chamados</h2>

<form method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label asp-for="Filtro.Status" class="form-label">Status</label>
            <select asp-for="Filtro.Status" class="form-select">
                <option value="">Todos</option>
                <option value="Aberto">Aberto</option>
                <option value="EmAndamento">EmAndamento</option>
                <option value="Concluido">Concluido</option>
            </select>
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.CriadoDe" class="form-label">Criado de</label>
            <input asp-for="Filtro.CriadoDe" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.CriadoAte" class="form-label">Criado até</label>
            <input asp-for="Filtro.CriadoAte" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.ModificadoDe" class="form-label">Modificado de</label>
            <input asp-for="Filtro.ModificadoDe" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.ModificadoAte" class="form-label">Modificado até</label>
            <input asp-for="Filtro.ModificadoAte" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a href="/Index" class="btn btn-secondary">Limpar filtros</a>
        </div>
    </div>
</form>

<h2>Lista de Chamados</h2>

@if (!Model.Chamados.Any())
{
    <p>Nenhum chamado cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Descrição</th>
                <th>Status</th>
                <th>Criado por</th>
                <th>Responsável</th>
                <th>Criado em</th>
                <th>Última modificação</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var chamado in Model.Chamados)
            {
                <tr>
                    <td>@chamado.Titulo</td>
                    <td>@chamado.Descricao</td>
                    <td>@chamado.Status</td>
                    <td>@(Model.NomesPorId.TryGetValue(chamado.CriadoPorId, out var criadoPorNome) ? criadoPorNome : "-")</td>
                    <td>@(Model.NomesPorId.TryGetValue(chamado.ResponsavelId, out var responsavelNome) ? responsavelNome : "-")</td>
                    <td>@chamado.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@chamado.DataUltimaModificacao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a href="/Index?editId=@chamado.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Excluir" asp-route-id="@chamado.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
