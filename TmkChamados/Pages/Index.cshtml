@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var opcoesJson = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<div class="tmk-eyebrow">Dashboard</div>
<h1>Resumo dos Tickets</h1>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="tmk-eyebrow">@Model.TituloSecao</div>
        @await Html.PartialAsync("_ResumoTicketsSecao", Model.Resumo, new ViewDataDictionary(ViewData) { { "Prefixo", "secao" } })
    </div>
    @if (Model.IsMaster)
    {
        <div class="col-12 col-lg-6">
            <div class="tmk-eyebrow">Abertos por Empresa</div>
            <div class="tmk-card mb-3" style="height: 250px; overflow: hidden;">
                <canvas id="pizza-empresa"></canvas>
            </div>
        </div>
    }
    <div class="col-12 col-lg-6">
        <div class="tmk-eyebrow">Abertos e Em Andamento por Prioridade</div>
        <div class="tmk-card mb-3" style="height: 250px; overflow: hidden;">
            <canvas id="pizza-prioridade"></canvas>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="tmk-eyebrow">Abertos e Em Andamento por Dias até o Prazo</div>
        <div class="tmk-card mb-3" style="height: 250px; overflow: hidden;">
            <canvas id="histograma-prazo"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        var TMK_PALETA = ['#F2C230', '#2A2A2E', '#C9A227', '#C9CAD2', '#F7DA7A', '#5B5C66'];

        function tmkCores(quantidade) {
            var cores = [];
            for (var i = 0; i < quantidade; i++) {
                cores.push(TMK_PALETA[i % TMK_PALETA.length]);
            }
            return cores;
        }

        function montarGraficosResumo(prefixo, dados) {
            new Chart(document.getElementById('pizza-' + prefixo), {
                type: 'pie',
                data: {
                    labels: ['Aberto', 'Em Andamento', 'Concluído'],
                    datasets: [{
                        data: [dados.pizzaAbertos, dados.pizzaEmAndamento, dados.pizzaConcluidos],
                        backgroundColor: tmkCores(3)
                    }]
                },
                options: {
                    maintainAspectRatio: false
                }
            });

            new Chart(document.getElementById('histograma-' + prefixo), {
                type: 'bar',
                data: {
                    labels: dados.histogramaRotulos,
                    datasets: [{
                        label: 'Tickets criados',
                        data: dados.histogramaValores,
                        backgroundColor: '#F2C230'
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        function montarGraficoPorRotulos(elementId, dados) {
            new Chart(document.getElementById(elementId), {
                type: 'pie',
                data: {
                    labels: dados.rotulos,
                    datasets: [{
                        data: dados.valores,
                        backgroundColor: tmkCores(dados.valores.length)
                    }]
                },
                options: {
                    maintainAspectRatio: false
                }
            });
        }

        function montarGraficoBarrasPorRotulos(elementId, dados, label) {
            new Chart(document.getElementById(elementId), {
                type: 'bar',
                data: {
                    labels: dados.rotulos,
                    datasets: [{
                        label: label,
                        data: dados.valores,
                        backgroundColor: '#F2C230'
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }

        montarGraficosResumo('secao', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Resumo, opcoesJson)));
        @if (Model.IsMaster)
        {
            @:montarGraficoPorRotulos('pizza-empresa', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoAbertosPorEmpresa, opcoesJson)));
        }
        montarGraficoPorRotulos('pizza-prioridade', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoPorPrioridade, opcoesJson)));
        montarGraficoBarrasPorRotulos('histograma-prazo', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoPorDiasParaPrazo, opcoesJson)), 'Tickets');
    </script>
}
