@page
@model OrcamentosFormModel
@{
    ViewData["Title"] = "Novo Orçamento";
}

<div class="tmk-eyebrow">Gestão</div>
<h1>Novo Orçamento</h1>

<form method="post" asp-page-handler="Adicionar" class="tmk-card mb-4">
    <input type="hidden" asp-for="TokenEnvio" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Form.Titulo" class="form-label">Título</label>
        <input asp-for="Form.Titulo" class="form-control" maxlength="200" />
        <span asp-validation-for="Form.Titulo" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Form.Descricao" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Form.Descricao" class="text-danger"></span>
    </div>

    <div class="form-text mb-3">O orçamento é criado como Rascunho. Os anexos podem ser adicionados na tela seguinte, antes de enviar ao Master.</div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Adicionar</button>
    <a href="/Orcamentos" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancelar</a>
</form>
