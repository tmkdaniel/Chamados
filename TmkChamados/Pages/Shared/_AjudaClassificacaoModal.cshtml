@using TmkChamados.Models

<div class="modal fade" id="ajudaClassificacaoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Classificações de Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                @foreach (var classificacao in ClassificacaoTicketInfo.Todas)
                {
                    <div class="tmk-card mb-3">
                        <h6>@classificacao.Label</h6>
                        <p class="mb-1"><strong>O que é:</strong> @classificacao.OQueE</p>
                        <p class="mb-1"><strong>Foco:</strong> @classificacao.Foco</p>
                        <p class="mb-0"><strong>Exemplo de título:</strong> @classificacao.ExemploTitulo</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
