@model TmkChamados.Pages.Shared.AjudaGraficoViewModel

<div class="modal fade" id="@Model.Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Model.Titulo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2"><strong>O que mostra:</strong> @Model.Explicacao</p>
                <p class="mb-0"><strong>Uso prático:</strong> @Model.UsoPratico</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
