@page
@using TmkChamados.Models
@model TicketsModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="tmk-eyebrow">Gestão</div>
<h1>Tickets</h1>

<p>
    <a href="/TicketsForm" class="btn btn-primary">Novo Ticket</a>
</p>

<div class="tmk-eyebrow">Filtrar Tickets</div>

<form method="get" class="tmk-card mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label asp-for="Filtro.Classificacao" class="form-label">Classificação</label>
            <select asp-for="Filtro.Classificacao" class="form-select">
                <option value="">Todas</option>
                @foreach (var classificacao in ClassificacaoTicketInfo.Todas)
                {
                    <option value="@classificacao.Valor">@classificacao.Label</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.StatusFiltro" class="form-label">Status</label>
            <select asp-for="Filtro.StatusFiltro" class="form-select">
                <option value="">Todos</option>
                <option value="AbertoEmAndamento">Aberto e Em Andamento</option>
                <option value="Aberto">Aberto</option>
                <option value="EmAndamento">EmAndamento</option>
                <option value="Concluido">Concluido</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.Prioridade" class="form-label">Prioridade</label>
            <select asp-for="Filtro.Prioridade" class="form-select">
                <option value="">Todas</option>
                <option value="Normal">Normal</option>
                <option value="Alta">Alta</option>
                <option value="Urgente">Urgente</option>
            </select>
        </div>
        @if (Model.IsMaster)
        {
            <div class="col-auto">
                <label asp-for="Filtro.EmpresaId" class="form-label">Empresa</label>
                <select asp-for="Filtro.EmpresaId" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var empresa in Model.Empresas)
                    {
                        <option value="@empresa.Id">@empresa.Nome</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label asp-for="Filtro.CriadoPorId" class="form-label">Criado por</label>
                <select asp-for="Filtro.CriadoPorId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var usuario in Model.UsuariosParaFiltroCriadoPorMaster)
                    {
                        <option value="@usuario.Id">@usuario.Nome</option>
                    }
                </select>
            </div>
        }
        @if (Model.IsGerente)
        {
            <div class="col-auto">
                <label asp-for="Filtro.CriadoPorId" class="form-label">Criado por</label>
                <select asp-for="Filtro.CriadoPorId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var usuario in Model.UsuariosDaEmpresa)
                    {
                        <option value="@usuario.Id">@usuario.Nome</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto">
            <label asp-for="Filtro.ResponsavelFiltro" class="form-label">Responsável</label>
            <select asp-for="Filtro.ResponsavelFiltro" class="form-select">
                <option value="">Todos</option>
                <option value="none">Sem Responsável</option>
                @foreach (var usuario in Model.UsuariosMaster)
                {
                    <option value="@usuario.Id">@usuario.Nome</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.CriadoDe" class="form-label">Criado de</label>
            <input asp-for="Filtro.CriadoDe" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.CriadoAte" class="form-label">Criado até</label>
            <input asp-for="Filtro.CriadoAte" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.ModificadoDe" class="form-label">Modificado de</label>
            <input asp-for="Filtro.ModificadoDe" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <label asp-for="Filtro.ModificadoAte" class="form-label">Modificado até</label>
            <input asp-for="Filtro.ModificadoAte" type="date" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a href="/Tickets" class="btn btn-secondary">Limpar filtros</a>
        </div>
    </div>
</form>

<div class="tmk-eyebrow">Lista de Tickets</div>

@if (!Model.Tickets.Any())
{
    <p>Nenhum ticket cadastrado.</p>
}
else
{
    <div class="tmk-card p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Classificação</th>
                <th>Título</th>
                <th>Descrição</th>
                <th>Status</th>
                <th>Prioridade</th>
                <th>Criado por</th>
                @if (Model.IsMaster)
                {
                    <th>Empresa</th>
                }
                <th>Responsável</th>
                <th>Criado em</th>
                <th>Última modificação</th>
                <th>Prazo</th>
                <th>Conclusão</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>@ClassificacaoTicketInfo.ObterLabel(ticket.Classificacao)</td>
                    <td>@ticket.Titulo</td>
                    <td>@ticket.Descricao</td>
                    <td><span class="badge @Model.ClasseCorStatus(ticket.Status)">@ticket.Status</span></td>
                    <td>@ticket.Prioridade</td>
                    <td>@(Model.NomesPorId.TryGetValue(ticket.CriadoPorId, out var criadoPorNome) ? criadoPorNome : "-")</td>
                    @if (Model.IsMaster)
                    {
                        <td>@(Model.EmpresaPorUsuarioId.TryGetValue(ticket.CriadoPorId, out var empresaNome) ? empresaNome : "-")</td>
                    }
                    <td>@(ticket.ResponsavelId.HasValue && Model.NomesPorId.TryGetValue(ticket.ResponsavelId.Value, out var responsavelNome) ? responsavelNome : "Nenhum")</td>
                    <td>@ticket.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@ticket.DataUltimaModificacao.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(ticket.DataPrazo.HasValue ? ticket.DataPrazo.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>@(ticket.DataConclusao.HasValue ? ticket.DataConclusao.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                    <td>
                        <a href="/TicketView?id=@ticket.Id" class="btn btn-sm btn-outline-primary">Visualizar</a>
                        @if (Model.IsMaster)
                        {
                            <form method="post" asp-page-handler="Excluir" asp-route-id="@ticket.Id" id="excluir-ticket-@ticket.Id" class="d-inline"></form>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal" data-bs-target="#modalConfirmarExclusao"
                                    onclick="document.getElementById('btnConfirmarExclusao').setAttribute('form', 'excluir-ticket-@ticket.Id')">
                                Excluir
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir este ticket?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" id="btnConfirmarExclusao" class="btn btn-danger" data-bs-dismiss="modal">Confirmar exclusão</button>
            </div>
        </div>
    </div>
</div>
