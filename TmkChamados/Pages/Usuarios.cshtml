@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários</h1>

@if (!string.IsNullOrEmpty(Model.ErroExclusao))
{
    <div class="alert alert-danger">@Model.ErroExclusao</div>
}

<form method="post" asp-page-handler="@(Model.EmEdicao ? "Atualizar" : "Adicionar")" class="mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Form.Id" />

    @if (Model.EmEdicao)
    {
        <div class="mb-2">
            <label class="form-label">Id</label>
            <input type="text" value="@Model.Form.Id" class="form-control" readonly />
        </div>
    }

    <div class="mb-2">
        <label asp-for="Form.Nome" class="form-label">Nome</label>
        <input asp-for="Form.Nome" class="form-control" />
        <span asp-validation-for="Form.Nome" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        @(Model.EmEdicao ? "Atualizar" : "Adicionar")
    </button>
    @if (Model.EmEdicao)
    {
        <a href="/Usuarios" class="btn btn-secondary">Cancelar</a>
    }
</form>

<h2>Lista de Usuários</h2>

@if (!Model.Usuarios.Any())
{
    <p>Nenhum usuário cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model.Usuarios)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nome</td>
                    <td>
                        <a href="/Usuarios?editId=@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Excluir" asp-route-id="@usuario.Id" id="excluir-usuario-@usuario.Id" class="d-inline"></form>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#modalConfirmarExclusao"
                                onclick="document.getElementById('btnConfirmarExclusao').setAttribute('form', 'excluir-usuario-@usuario.Id')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir este usuário?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" id="btnConfirmarExclusao" class="btn btn-danger" data-bs-dismiss="modal">Confirmar exclusão</button>
            </div>
        </div>
    </div>
</div>
