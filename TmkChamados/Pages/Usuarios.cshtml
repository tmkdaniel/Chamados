@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários</h1>

@if (!string.IsNullOrEmpty(Model.ErroExclusao))
{
    <div class="alert alert-danger">@Model.ErroExclusao</div>
}

<p>
    <a href="/UsuariosForm" class="btn btn-primary">Novo Usuário</a>
</p>

<h2>Lista de Usuários</h2>

@if (!Model.Usuarios.Any())
{
    <p>Nenhum usuário cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model.Usuarios)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nome</td>
                    <td>
                        <a href="/UsuariosForm?editId=@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Excluir" asp-route-id="@usuario.Id" id="excluir-usuario-@usuario.Id" class="d-inline"></form>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#modalConfirmarExclusao"
                                onclick="document.getElementById('btnConfirmarExclusao').setAttribute('form', 'excluir-usuario-@usuario.Id')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir este usuário?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" id="btnConfirmarExclusao" class="btn btn-danger" data-bs-dismiss="modal">Confirmar exclusão</button>
            </div>
        </div>
    </div>
</div>
