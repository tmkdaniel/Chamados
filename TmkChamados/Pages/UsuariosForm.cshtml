@page
@model UsuariosFormModel
@{
    ViewData["Title"] = Model.EmEdicao ? "Editar Usuário" : "Novo Usuário";
}

<div class="tmk-eyebrow">Administração</div>
<h1>@(Model.EmEdicao ? "Editar Usuário" : "Novo Usuário")</h1>

<form method="post" asp-page-handler="@(Model.EmEdicao ? "Atualizar" : "Adicionar")" class="tmk-card mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Form.Id" />

    @if (Model.EmEdicao)
    {
        <div class="mb-2">
            <label class="form-label">Id</label>
            <input type="text" value="@Model.Form.Id" class="form-control" readonly />
        </div>
    }

    <div class="mb-2">
        <label asp-for="Form.Nome" class="form-label">Nome</label>
        <input asp-for="Form.Nome" class="form-control" />
        <span asp-validation-for="Form.Nome" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Senha" class="form-label">Senha</label>
        <input asp-for="Form.Senha" type="password" class="form-control" />
        <span asp-validation-for="Form.Senha" class="text-danger"></span>
        @if (Model.EmEdicao)
        {
            <div class="form-text">Deixe em branco para manter a senha atual.</div>
        }
    </div>

    <div class="mb-2">
        <label asp-for="Form.Tipo" class="form-label">Tipo</label>
        <select asp-for="Form.Tipo" class="form-select">
            <option value="">Selecione</option>
            <option value="Master">Master</option>
            <option value="Gerente">Gerente</option>
            <option value="Usuario">Usuario</option>
        </select>
        <span asp-validation-for="Form.Tipo" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.EmpresaId" class="form-label">Empresa</label>
        <select asp-for="Form.EmpresaId" class="form-select">
            <option value="">Selecione</option>
            @foreach (var empresa in Model.Empresas)
            {
                <option value="@empresa.Id">@empresa.Nome</option>
            }
        </select>
        <span asp-validation-for="Form.EmpresaId" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Form.Email" class="form-label">Email</label>
        <input asp-for="Form.Email" type="email" class="form-control" />
        <span asp-validation-for="Form.Email" class="text-danger"></span>
        <div class="form-text">Opcional. Usado para enviar notificações de alterações em tickets.</div>
    </div>

    <button type="submit" class="btn btn-primary">
        @(Model.EmEdicao ? "Atualizar" : "Adicionar")
    </button>
    <a href="/Usuarios" class="btn btn-secondary">Cancelar</a>
</form>
